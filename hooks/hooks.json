{
  "description": "Opt-in glassbox hooks. UserPromptSubmit adds graph context to code prompts (ambient option). Stop checks the turn's diff once and can ask for one more look at High risk lines (gate option). PostToolUse and SessionStart keep the graph and the AGENTS.md block fresh (enable_hooks option). All of them do nothing in a repo without a glassbox graph, and they never fail the turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/glassbox-hook.sh", "prompt"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/glassbox-hook.sh", "stop"],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/glassbox-hook.sh", "post-edit"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/glassbox-hook.sh", "session-start"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
